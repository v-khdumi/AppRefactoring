# Azure AI Foundry model inference (server-side only)
AZURE_AI_FOUNDRY_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/models
AZURE_AI_FOUNDRY_API_KEY=
AZURE_AI_FOUNDRY_MODEL=gpt-6-astra
AZURE_AI_FOUNDRY_API_VERSION=2024-05-01-preview

# Optional GitHub App / fallback token (prefer GitHub App in production)
GITHUB_TOKEN=

# Demo behavior must be enabled explicitly. Production always uses false.
DEMO_MODE=false

# PostgreSQL persistence
DATABASE_URL=postgresql://modernize:password@localhost:5432/modernize

# Microsoft Entra ID API authorization
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
NEXT_PUBLIC_AZURE_TENANT_ID=
NEXT_PUBLIC_AZURE_CLIENT_ID=
NEXT_PUBLIC_AZURE_API_SCOPE=

# Durable transformation dispatch
AZURE_SERVICE_BUS_CONNECTION_STRING=
# Preferred in Azure: fully qualified namespace with Managed Identity, for example example.servicebus.windows.net
AZURE_SERVICE_BUS_NAMESPACE=
AZURE_SERVICE_BUS_QUEUE=modernization-runs

# GitHub App (never use a personal token for unattended writes)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=
NEXT_PUBLIC_GITHUB_APP_SLUG=modernizeai-khaled

# Random value of at least 32 characters used only by internal deep-health probes.
HEALTH_CHECK_TOKEN=

# Optional Azure Key Vault
KEY_VAULT_URL=

# Identity-free Azure Container Apps Job for isolated Node/npm verification.
# Web and worker managed identities need jobs/start/action on this job only.
VERIFICATION_JOB_RESOURCE_ID=
VERIFICATION_PUBLIC_ORIGIN=