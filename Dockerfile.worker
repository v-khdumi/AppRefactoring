FROM node:22-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914
WORKDIR /app
ENV NODE_ENV=production
RUN apk upgrade --no-cache \
    && addgroup --system --gid 1001 modernize && adduser --system --uid 1001 worker
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force \
	&& rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx /opt/yarn* /usr/local/bin/yarn /usr/local/bin/yarnpkg
COPY tsconfig.json ./
COPY src ./src
COPY worker ./worker
COPY scripts ./scripts
COPY database ./database
USER worker
CMD ["node", "node_modules/tsx/dist/cli.mjs", "worker/start.mjs"]